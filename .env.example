# Copie para .env (nunca vai para o git).
NODE_ENV=production
PORT=8080
PUBLIC_BASE_URL=https://agentes.maso.app.br

# Supabase do motor (projeto mavi-agentes)
DATABASE_URL=postgres://postgres.<ref>:<senha>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SECRET_KEY=

# LLMs
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Cofre das chaves dos agentes: openssl rand -base64 32
SECRETS_KEY=
DEFAULT_MODEL=openai/gpt-5.2
FALLBACK_MODEL=openai/gpt-4.1
UTILITY_MODEL=openai/gpt-5-mini

# MakeCRM (Supabase htdjkprnspssogcetzhx)
MAKECRM_SUPABASE_URL=https://htdjkprnspssogcetzhx.supabase.co
MAKECRM_PUBLISHABLE_KEY=
MAKECRM_SECRET_KEY=
MAKECRM_DRY_RUN=false

WORKER_CONCURRENCY=20
