{
  "name": "mavi-agentes",
  "version": "0.1.0",
  "private": true,
  "description": "Motor de agentes conversacionais da Make Vendas",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch src/main-api.ts",
    "dev:worker": "tsx watch src/main-worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/main-api.js",
    "start:worker": "node dist/main-worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "api-client": "tsx scripts/create-api-client.ts"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.3",
    "bullmq": "6.3.11",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "mammoth": "1.13.0",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
